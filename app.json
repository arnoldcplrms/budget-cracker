{
  "expo": {
    "name": "Budget Cracker",
    "slug": "budget-cracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#FAF6EE",
    "icon": "./assets/budget-cracker-logo.png",
    "splash": {
      "image": "./assets/budget-cracker-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6EE"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EE",
        "foregroundImage": "./assets/budget-cracker-logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.budgetcracker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/budget-cracker-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF6EE",
          "imageWidth": 220
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-splash-screen"
    ]
  }
}
